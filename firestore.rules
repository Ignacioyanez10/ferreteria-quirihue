rules_version = '2';

// Reglas de seguridad de Firestore para la web de Ferretería Quirihue.
// Copiar y pegar en: Firebase Console > Firestore Database > Reglas > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo estas cuentas pueden modificar promociones.
    // Reemplaza PEGA_AQUI_TU_UID por el UID que aparece al pie del panel de administrador
    // (o en Firebase Console > Authentication > Usuarios). Puedes agregar más separados por coma.
    function esAdmin() {
      return request.auth != null && request.auth.uid in ['peDiAyaMyBTh1nHuCQkADvLQe9B2'];
    }

    function promoValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['imagen', 'descripcion', 'orden', 'activa', 'actualizada'])
        && d.imagen is string && d.imagen.matches('^data:image/(jpeg|png|webp);base64,.*')
        && d.imagen.size() < 1000000
        && d.descripcion is string && d.descripcion.size() <= 300
        && d.orden is number
        && d.activa is bool;
    }

    match /promos/{id} {
      allow read: if true;                       // la web pública puede ver las promociones
      allow create, update: if esAdmin() && promoValida();
      allow delete: if esAdmin();
    }

    // Todo lo demás queda cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
