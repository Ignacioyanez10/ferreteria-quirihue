val="24"/></w:rPr><w:t>ip´s</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002B6BFC"><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve"> de único uso, repetidores de señal, y software para la conexión </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002B6BFC"><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>vpn</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002B6BFC"><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">. En </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002B6BFC"><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>conclusión</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="002B6BFC"><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve"> la </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002B6BFC"><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>practica</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002B6BFC"><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve"> demuestra la realidad de un entorno laboral de soporte, la gran variedad de tareas diferentes lo que ayuda a la capacidad de sobrepasar dificultades y mejorar exponencialmente la capacidad de organización para trabajar en equipo y optimizar el trabajo del departamento.  </w:t></w:r></w:p><w:sectPr w:rsidR="002B6BFC" w:rsidRPr="002B6BFC" w:rsidSect="008005BD"><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="709" w:footer="709" w:gutter="0"/><w:cols w:space="708"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>